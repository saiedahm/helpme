# Copy to the server's secret manager / local .env.local. Never commit real values.
NODE_ENV=production
APP_ORIGIN=https://YOUR_OFFICIAL_DOMAIN.example
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
UPSTASH_REDIS_REST_URL=https://YOUR-UPSTASH-REDIS-ENDPOINT
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_SECRET
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_SECRET
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_SECRET
# Generate a high-entropy session secret separately if your auth provider requires one.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
